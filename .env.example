# Copy file này thành .env rồi chỉnh giá trị. KHÔNG commit file .env.
PORT=8989
HOST=0.0.0.0

# Bắt buộc đặt PIN riêng, dài và khó đoán (không dùng 123456).
# Nếu bỏ trống, server sẽ tự sinh PIN ngẫu nhiên mỗi lần khởi động và in ra console.
ADMIN_PIN=

SERVER_NAME="AI Core music"
REQUESTS_ENABLED=true
REQUEST_COOLDOWN_SECONDS=0
MAX_REQUESTS_PER_DEVICE=20
DATABASE_PATH=data/jukebox.db

# Chế độ tunnel khi chạy start-music.bat: cloudflare | localtunnel | ngrok | none
TUNNEL_MODE=cloudflare
CUSTOM_DOMAIN=music.lpsang.id.vn
CLOUDFLARE_TUNNEL_TOKEN=
LT_SUBDOMAIN=aicoremusic
NGROK_DOMAIN=
